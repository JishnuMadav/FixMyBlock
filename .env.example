# Copy to .env. Leave the key empty for the labeled rules-based demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local demonstration only. Real operator authentication is required before hosting.
DEMO_MODE=true

# Student email sign-in (WorkOS dashboard: enable Magic Auth and its emails)
AUTH_REQUIRED=true
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Comma-separated verified emails allowed to use the maintenance queue.
WORKOS_OPERATOR_EMAILS=
# Set true for HTTPS deployment; false only for local HTTP.
COOKIE_SECURE=false

# Optional exact public HTTPS origin for a hosted demo; leave blank locally.
PUBLIC_ORIGIN=
